# data-source manifest (tracked; verified by src/urban_energy/fetch.py)
!data/manifest.json
# Zenodo release metadata (must be tracked for the archived release)
!.zenodo.json
# Frozen NEPI band thresholds (the freeze depends on this file surviving)
!dissemination/nepi_bands_2021.json
# Atlas site data (small, regenerable, needed by site/; heavy artefacts are
# excluded by site/.gitignore)
!site/data/aggregates.json
!site/data/meta.json
# manuscript number ledger (accumulators; without them a partial stats run
# would regenerate numbers.tex/tab_*.tex with missing macros)
!paper/latex/numbers.json
!paper/latex/tables.json
# submission correspondence stays local
paper/cover_letter.md
